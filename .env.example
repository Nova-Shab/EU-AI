# ============================================
# n8n Configuration
# ============================================

# Server Configuration
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=https
N8N_PATH=/

# Base URL for webhooks (replace with your domain)
WEBHOOK_URL=https://your-domain.com

# ============================================
# Security & Authentication
# ============================================

# Basic Authentication (recommended for production)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-this-secure-password

# JWT Secret (generate a random string)
N8N_JWT_SECRET=your-jwt-secret-key-change-this

# Encryption Key (generate a random string, used for credential encryption)
N8N_ENCRYPTION_KEY=your-encryption-key-change-this

# ============================================
# Database Configuration
# ============================================

# Database Type (options: sqlite, postgresdb, mysqldb, mariadb)
DB_TYPE=postgresdb

# PostgreSQL Configuration (recommended for production)
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=your-db-password-change-this
DB_POSTGRESDB_SCHEMA=public

# Alternative: SQLite (for development/testing only)
# DB_TYPE=sqlite
# DB_SQLITE_DATABASE=/home/node/.n8n/database.sqlite

# ============================================
# Execution Configuration
# ============================================

# Execution Mode (regular, queue)
EXECUTIONS_MODE=regular

# Number of concurrent executions
N8N_CONCURRENCY=10

# Execution timeout (in seconds)
EXECUTIONS_TIMEOUT=3600

# Max execution timeout (in seconds)
EXECUTIONS_TIMEOUT_MAX=7200

# ============================================
# External Service API Keys
# ============================================

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.3

# Alternative: Anthropic Claude API
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# Database Service (Airtable)
# ============================================

# Airtable Configuration (if using Airtable as database)
AIRTABLE_API_KEY=your-airtable-api-key
AIRTABLE_BASE_ID=your-airtable-base-id

# Table IDs
AIRTABLE_USERS_TABLE=users
AIRTABLE_REPORTS_TABLE=reports

# ============================================
# PDF Generation Service
# ============================================

# HTML2PDF Service (or similar)
HTML2PDF_API_KEY=your-html2pdf-api-key
HTML2PDF_API_URL=https://api.html2pdf.app/v1/generate

# Alternative: Local Puppeteer/wkhtmltopdf
# PDF_GENERATION_METHOD=local

# ============================================
# File Storage Configuration
# ============================================

# Storage Type (local, s3, azure, gcs)
STORAGE_TYPE=local

# Local Storage Path
STORAGE_LOCAL_PATH=/home/node/.n8n/storage

# AWS S3 Configuration (if using S3)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1

# ============================================
# Email Configuration (for notifications)
# ============================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com
SMTP_TLS=true

# ============================================
# Logging & Monitoring
# ============================================

# Log Level (error, warn, info, verbose, debug)
N8N_LOG_LEVEL=info

# Log Output (console, file)
N8N_LOG_OUTPUT=console

# Log File Path (if using file output)
N8N_LOG_FILE_LOCATION=/var/log/n8n/n8n.log

# ============================================
# Performance & Optimization
# ============================================

# Cache Configuration
N8N_CACHE_ENABLED=true
N8N_CACHE_TTL=3600

# Webhook Wait Time (in ms)
N8N_WEBHOOK_WAIT_TIME=120000

# Maximum Payload Size (in MB)
N8N_PAYLOAD_SIZE_MAX=16

# ============================================
# CORS Configuration
# ============================================

# CORS Enabled
N8N_CORS_ENABLED=true

# Allowed Origins (comma-separated)
N8N_CORS_ORIGINS=https://your-frontend-domain.com,https://app.your-domain.com

# ============================================
# Rate Limiting
# ============================================

# Enable Rate Limiting
RATE_LIMIT_ENABLED=true

# Max Requests per Window
RATE_LIMIT_MAX_REQUESTS=100

# Window Duration (in seconds)
RATE_LIMIT_WINDOW=60

# ============================================
# Feature Flags
# ============================================

# Enable Email Notifications
FEATURE_EMAIL_NOTIFICATIONS=true

# Enable Batch Analysis
FEATURE_BATCH_ANALYSIS=false

# Enable Analytics
FEATURE_ANALYTICS=true

# ============================================
# Application Settings
# ============================================

# Default Report Language
DEFAULT_LANGUAGE=en

# Report Retention Period (in days)
REPORT_RETENTION_DAYS=90

# Maximum URL Fetch Timeout (in ms)
URL_FETCH_TIMEOUT=30000

# Maximum Content Length for Analysis (in characters)
MAX_CONTENT_LENGTH=10000

# ============================================
# Security Headers
# ============================================

# Enable Security Headers
SECURITY_HEADERS_ENABLED=true

# Content Security Policy
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'"

# ============================================
# Backup Configuration
# ============================================

# Automatic Backup Enabled
BACKUP_ENABLED=true

# Backup Frequency (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup Retention (in days)
BACKUP_RETENTION_DAYS=30

# Backup Location
BACKUP_PATH=/backups/n8n

# ============================================
# Development Settings (DO NOT USE IN PRODUCTION)
# ============================================

# Skip Authentication (DEVELOPMENT ONLY)
# N8N_SKIP_AUTH=true

# Enable Debug Mode
# N8N_DEBUG=true

# Disable SSL Verification (DEVELOPMENT ONLY)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ============================================
# Custom Webhook Paths
# ============================================

# Custom path prefixes for webhooks
WEBHOOK_AUTH_REGISTER=/webhook/auth/register
WEBHOOK_AUTH_LOGIN=/webhook/auth/login
WEBHOOK_ANALYZE=/webhook/analyze
WEBHOOK_STATUS=/webhook/status
WEBHOOK_DOWNLOAD=/webhook/download
