      "id": "fetch-website",
      "name": "Fetch Website Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 600]
    },
    {
      "parameters": {
        "jsCode": "// Extract text content from HTML\nconst items = $input.all();\n\nfor (const item of items) {\n  const html = item.json.data || item.json.body || '';\n  \n  // Simple HTML to text conversion (in production, use a proper library)\n  let text = html\n    .replace(/<script[^>]*>.*?<\\/script>/gis, '')\n    .replace(/<style[^>]*>.*?<\\/style>/gis, '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  \n  // Limit to first 10000 characters to avoid token limits\n  text = text.substring(0, 10000);\n  \n  item.json.extractedContent = text;\n}\n\nreturn items;"
      },
      "id": "extract-content",
      "name": "Extract Website Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1750, 600]
