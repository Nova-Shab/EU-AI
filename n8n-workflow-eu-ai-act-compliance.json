      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3250, 700],
      "notes": "Alternative: Use Puppeteer, wkhtmltopdf, or other PDF generation service"
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "reports",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "reportId",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.sessionId }}"
            },
            {
              "fieldId": "userId",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.userId }}"
            },
            {
              "fieldId": "riskLevel",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.analysisResult.riskClassification.level }}"
            },
            {
              "fieldId": "nonConformitiesCount",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.analysisResult.nonConformities.length }}"
