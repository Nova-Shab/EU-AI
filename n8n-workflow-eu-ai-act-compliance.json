    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "analysis-request",
              "name": "analysisPrompt",
              "value": "=You are an EU AI Act compliance expert. Analyze the following AI system and provide a comprehensive compliance assessment.\n\n## AI System Information:\n{{ $json.extractedContent }}\n\n## Your Task:\nAnalyze this AI system against the EU AI Act requirements and provide:\n\n1. **Risk Classification**: Determine if this is:\n   - Unacceptable Risk (prohibited)\n   - High Risk\n   - Limited Risk\n   - Minimal Risk\n\n2. **Compliance Analysis**: Identify all non-conformities with EU AI Act requirements\n\n3. **Recommended Actions**: Provide specific, actionable measures to address each deviation\n\nProvide your response in the following JSON format:\n```json\n{\n  \"riskClassification\": {\n    \"level\": \"High Risk|Limited Risk|Minimal Risk|Unacceptable Risk\",\n    \"reasoning\": \"Detailed explanation\",\n    \"articleReferences\": [\"Article X\", \"Article Y\"]\n  },\n  \"nonConformities\": [\n    {\n      \"id\": \"NC-001\",\n      \"title\": \"Brief title\",\n      \"description\": \"Detailed description\",\n      \"severity\": \"Critical|High|Medium|Low\",\n      \"articleReference\": \"Article X, Section Y\",\n      \"requirement\": \"Specific requirement not met\"\n    }\n  ],\n  \"recommendedMeasures\": [\n    {\n      \"nonConformityId\": \"NC-001\",\n      \"measure\": \"Specific action to take\",\n      \"priority\": \"Critical|High|Medium|Low\",\n      \"estimatedEffort\": \"Description of effort required\",\n      \"timeline\": \"Suggested timeline\"\n    }\n  ],\n  \"summary\": \"Executive summary of findings\"\n}\n```",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-ai-prompt",
      "name": "Prepare AI Analysis Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2250, 700]
    },
    {
      "parameters": {
        "model": "gpt-4-turbo-preview",
        "messages": {
          "messageValues": [
            {
              "role": "user",
              "message": "={{ $json.analysisPrompt }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 4000
        },
        "requestOptions": {}
      },
      "id": "analyze-with-ai",
      "name": "Analyze with OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [2500, 700],
      "credentials": {
        "openAiApi": {
          "id": "2",
          "name": "OpenAI Account"
        }
      },
      "notes": "Alternative: Use Claude API, local LLM, or other AI service"
    },
    {
      "parameters": {
        "jsCode": "// Parse AI response and structure the data\nconst items = $input.all();\n\nfor (const item of items) {\n  const response = item.json.message?.content || item.json.choices?.[0]?.message?.content || '';\n  \n  try {\n    // Extract JSON from response (handle markdown code blocks)\n    const jsonMatch = response.match(/```json\\s*([\\s\\S]*?)\\s*```/) || response.match(/\\{[\\s\\S]*\\}/);\n    \n    if (jsonMatch) {\n      const jsonStr = jsonMatch[1] || jsonMatch[0];\n      const analysisResult = JSON.parse(jsonStr);\n      \n      item.json.analysisResult = analysisResult;\n      item.json.parseSuccess = true;\n    } else {\n      item.json.parseSuccess = false;\n      item.json.rawResponse = response;\n    }\n  } catch (error) {\n    item.json.parseSuccess = false;\n    item.json.error = error.message;\n    item.json.rawResponse = response;\n  }\n  \n  // Get session data from earlier in the workflow\n  item.json.sessionId = $('Extract Analysis Request').item.json.sessionId;\n  item.json.userId = $('Validate Authentication').item.json.userId;\n}\n\nreturn items;"
      },
      "id": "parse-ai-response",
      "name": "Parse AI Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2750, 700]
    },
    {
      "parameters": {
        "jsCode": "// Generate HTML for PDF report\nconst items = $input.all();\n\nfor (const item of items) {\n  const analysis = item.json.analysisResult;\n  const sessionId = item.json.sessionId;\n  \n  const html = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: Arial, sans-serif; margin: 40px; line-height: 1.6; }\n    h1 { color: #003366; border-bottom: 3px solid #0066cc; padding-bottom: 10px; }\n    h2 { color: #0066cc; margin-top: 30px; }\n    h3 { color: #333; }\n    .header { text-align: center; margin-bottom: 40px; }\n    .risk-badge { display: inline-block; padding: 10px 20px; border-radius: 5px; font-weight: bold; }\n    .risk-high { background-color: #ff4444; color: white; }\n    .risk-limited { background-color: #ffaa00; color: white; }\n    .risk-minimal { background-color: #44aa44; color: white; }\n    .risk-unacceptable { background-color: #cc0000; color: white; }\n    .non-conformity { border-left: 4px solid #ff4444; padding-left: 15px; margin: 20px 0; background: #fff5f5; padding: 15px; }\n    .measure { border-left: 4px solid #0066cc; padding-left: 15px; margin: 20px 0; background: #f0f8ff; padding: 15px; }\n    .severity-critical { color: #cc0000; font-weight: bold; }\n    .severity-high { color: #ff4444; font-weight: bold; }\n    .severity-medium { color: #ffaa00; font-weight: bold; }\n    .severity-low { color: #44aa44; font-weight: bold; }\n    .footer { margin-top: 50px; text-align: center; color: #666; font-size: 0.9em; border-top: 1px solid #ccc; padding-top: 20px; }\n    table { width: 100%; border-collapse: collapse; margin: 20px 0; }\n    th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }\n    th { background-color: #003366; color: white; }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>EU AI Act Compliance Report</h1>\n    <p><strong>Report ID:</strong> ${sessionId}</p>\n    <p><strong>Generated:</strong> ${new Date().toLocaleString()}</p>\n  </div>\n\n  <h2>Risk Classification</h2>\n  <p>\n    <span class=\"risk-badge risk-${analysis.riskClassification.level.toLowerCase().replace(' ', '-')}\">\n      ${analysis.riskClassification.level}\n    </span>\n  </p>\n  <p><strong>Reasoning:</strong> ${analysis.riskClassification.reasoning}</p>\n  <p><strong>Article References:</strong> ${analysis.riskClassification.articleReferences.join(', ')}</p>\n\n  <h2>Executive Summary</h2>\n  <p>${analysis.summary}</p>\n\n  <h2>Non-Conformities Detected</h2>\n  <p>Total non-conformities found: <strong>${analysis.nonConformities.length}</strong></p>\n  \n  ${analysis.nonConformities.map(nc => `\n    <div class=\"non-conformity\">\n      <h3>${nc.id}: ${nc.title}</h3>\n      <p><strong>Severity:</strong> <span class=\"severity-${nc.severity.toLowerCase()}\">${nc.severity}</span></p>\n      <p><strong>Article Reference:</strong> ${nc.articleReference}</p>\n      <p><strong>Requirement:</strong> ${nc.requirement}</p>\n      <p><strong>Description:</strong> ${nc.description}</p>\n    </div>\n  `).join('')}\n\n  <h2>Recommended Measures</h2>\n  <p>Action plan with ${analysis.recommendedMeasures.length} recommended measures:</p>\n  \n  ${analysis.recommendedMeasures.map((measure, index) => `\n    <div class=\"measure\">\n      <h3>Measure ${index + 1} (for ${measure.nonConformityId})</h3>\n      <p><strong>Priority:</strong> <span class=\"severity-${measure.priority.toLowerCase()}\">${measure.priority}</span></p>\n      <p><strong>Action:</strong> ${measure.measure}</p>\n      <p><strong>Estimated Effort:</strong> ${measure.estimatedEffort}</p>\n      <p><strong>Timeline:</strong> ${measure.timeline}</p>\n    </div>\n  `).join('')}\n\n  <div class=\"footer\">\n    <p>This report was generated automatically by the EU AI Act Compliance Checker.</p>\n    <p>For questions or support, please contact your compliance team.</p>\n    <p><em>This report is for informational purposes only and does not constitute legal advice.</em></p>\n  </div>\n</body>\n</html>\n  `;\n  \n  item.json.reportHtml = html;\n}\n\nreturn items;"
      },
      "id": "generate-html-report",
      "name": "Generate HTML Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3000, 700]
    },
    {
      "parameters": {
        "url": "https://api.html2pdf.app/v1/generate",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "html2PdfApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "html",
              "value": "={{ $json.reportHtml }}"
