    {
      "parameters": {
        "jsCode": "// Validate authentication token\nconst items = $input.all();\n\nfor (const item of items) {\n  const token = item.json.authToken;\n  \n  if (!token || token === 'undefined') {\n    item.json.authenticated = false;\n    item.json.error = 'No authentication token provided';\n  } else {\n    // In production, verify token against database\n    item.json.authenticated = true;\n    item.json.userId = token.split('.')[0];\n  }\n}\n\nreturn items;"
      },
